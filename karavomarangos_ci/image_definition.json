{
  "name": "karavomarangos_ci",
  "base_image": "harbor.windmaker.net/limani/base_docker",
  "maintainer": {
    "name": "Álvaro",
    "surname": "Castellano Vela",
    "email": "alvaro@windmaker.net"
  },
  "packages": [
    {
      "name": "gpg",
      "version": "2.4.8-4ubuntu3.1"
    },
    {
      "name": "gnupg",
      "version": "2.4.8-4ubuntu3.1"
    },
    {
      "name": "python3-jsonschema",
      "version": "4.19.2-6ubuntu2"
    },
    {
      "name": "moreutils",
      "version": "0.69-1build1"
    },
    {
      "name": "shunit2",
      "version": "2.1.8-4build1"
    },
    {
      "name": "make",
      "version": "4.4.1-3"
    },
    {
      "name": "wget",
      "version": "1.25.0-2ubuntu4.4"
    },
    {
      "name": "jq",
      "version": "1.8.1-4ubuntu2"
    },
    {
      "name": "ca-certificates",
      "version": "20260816ubuntu0.26.04.2"
    }
  ],
  "copy": [
    {
      "source": "argbash",
      "destination": "/usr/local/bin/argbash"
    }
  ],
  "extra_commands": [
    "wget https://github.com/hairyhenderson/gomplate/releases/download/v5.3.1/gomplate_linux-amd64 -O /usr/local/bin/gomplate",
    "chmod +x /usr/local/bin/gomplate",
    "chmod +x /usr/local/bin/argbash"
  ],
  "readme": {
    "description": "CI image for karavomarangos: jsonschema, shunit2, jq, moreutils, make, gnupg, gomplate, and argbash on top of Limani base_docker.",
    "additional_features": [
      "Gomplate v5.3.1 installed with wget after package install",
      "argbash copied from build context to /usr/local/bin/argbash"
    ]
  }
}
